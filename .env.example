NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pulled in locally after the Vercel AWS Aurora PostgreSQL integration is attached:
AWS_REGION=us-west-2
AWS_ROLE_ARN=replace-after-vercel-env-pull
PGHOST=replace-after-vercel-env-pull
PGPORT=5432
PGUSER=replace-after-vercel-env-pull
PGDATABASE=postgres
VERCEL_OIDC_TOKEN=replace-after-vercel-env-pull

# Future recruiter search + recommender email services:
AWS_ACCESS_KEY_ID=replace-me-if-needed-outside-vercel-oidc
AWS_SECRET_ACCESS_KEY=replace-me-if-needed-outside-vercel-oidc
AWS_OPENSEARCH_ENDPOINT=https://your-domain.us-west-2.es.amazonaws.com
AWS_OPENSEARCH_CANDIDATES_INDEX=recai-candidates
AWS_SES_FROM_EMAIL=hello@recai.app

# Amazon Bedrock — recruiter AI summary
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
# Inherits AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the existing recruiter-search block.
# AWS_SESSION_TOKEN= # optional, only when using temporary credentials.

# Recommender verification (Resend OTP + ICANN RDAP company lookup)
RESEND_API_KEY=
RESEND_FROM_EMAIL=verify@recai.app
RECOMMENDER_OTP_SALT=
# Optional: bypass RDAP and use only the local stub map (handy for offline demos)
RECOMMENDER_USE_STUB_COMPANY_LOOKUP=
# Optional: JSON map of domain -> { companyId, companyName } overriding the default stub
RECOMMENDER_STUB_COMPANY_MAP=